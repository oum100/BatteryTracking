generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MovementStage {
  STOCK_TO_CHARGE
  CHARGE_TO_DELIVERY
  DELIVERY_TRANSFER
}

enum BatteryJobPhase {
  BEFORE_CHARGE
  AFTER_CHARGE
  DELIVERY
}

enum BatteryJobStatus {
  NEW_JOB
  BEFORE_CHARGING
  AFTER_CHARGING
  QC_FOR_DELIVERY
  SHIPPED
}

enum ShipToFactory {
  AAT
  FTM
}

model Battery {
  id            String        @id @default(cuid())
  code          String        @unique
  label         String
  chemistry     String?
  capacityMah   Int?
  nominalVolt   Float?
  cycleCount    Int           @default(0)
  healthPercent Int?
  status        String        @default("IN_STOCK")
  location      String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model BatteryMovement {
  id                String        @id @default(cuid())
  stage             MovementStage
  fromRack          String
  fromSlot          String
  batterySn         String
  voltage           Float
  voltageMeasuredAt DateTime?
  toRack            String
  toSlot            String
  scanSource        String?
  voltageSource     String?
  deviceId          String?
  firmwareVersion   String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([stage, createdAt])
  @@index([batterySn, createdAt])
}

model Employee {
  id                      String       @id @default(cuid())
  code                    String       @unique
  name                    String
  active                  Boolean      @default(true)
  jobs                    BatteryJob[]
  beforeChargeJobs        BatteryJob[] @relation("BeforeChargeOperator")
  afterChargeJobs         BatteryJob[] @relation("AfterChargeOperator")
  beforeDeliveryJobs      BatteryJob[] @relation("BeforeDeliveryOperator")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([active, name])
}

model SalesOrder {
  id          String       @id @default(cuid())
  soNumber    String       @unique
  description String?
  active      Boolean      @default(true)
  jobs        BatteryJob[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([active, soNumber])
}

model Invoice {
  id          String       @id @default(cuid())
  invoiceNo   String       @unique
  description String?
  active      Boolean      @default(true)
  jobs        BatteryJob[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([active, invoiceNo])
}

model ChargeChannel {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  active    Boolean      @default(true)
  jobs      BatteryJob[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([active, code])
  @@index([active, name])
}

model ChargeProgram {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  active    Boolean      @default(true)
  jobs      BatteryJob[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([active, code])
  @@index([active, name])
}

model BatteryJob {
  id                       String            @id @default(cuid())
  batchId                  String?
  phase                    BatteryJobPhase   @default(BEFORE_CHARGE)
  status                   BatteryJobStatus  @default(NEW_JOB)
  rackId                   String
  openedAt                 DateTime
  operatorId               String?
  operator                 Employee?         @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  beforeChargeOperatorId   String?
  beforeChargeOperator     Employee?         @relation("BeforeChargeOperator", fields: [beforeChargeOperatorId], references: [id], onDelete: SetNull)
  afterChargeOperatorId    String?
  afterChargeOperator      Employee?         @relation("AfterChargeOperator", fields: [afterChargeOperatorId], references: [id], onDelete: SetNull)
  beforeDeliveryOperatorId String?
  beforeDeliveryOperator   Employee?         @relation("BeforeDeliveryOperator", fields: [beforeDeliveryOperatorId], references: [id], onDelete: SetNull)
  salesOrderId             String?
  salesOrder               SalesOrder?       @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  invoiceId                String?
  invoice                  Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  chargeChannelId          String?
  chargeChannel            ChargeChannel?    @relation(fields: [chargeChannelId], references: [id], onDelete: SetNull)
  chargeProgramId          String?
  chargeProgram            ChargeProgram?    @relation(fields: [chargeProgramId], references: [id], onDelete: SetNull)
  plannedDeliveryDate      DateTime?
  shipTo                   ShipToFactory?
  beforeChargeCompletedAt  DateTime?
  afterChargeCompletedAt   DateTime?
  deliveryCompletedAt      DateTime?
  lockedAt                 DateTime?
  notes                    String?
  slots                    BatteryJobSlot[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@index([batchId, createdAt])
  @@index([rackId, createdAt])
  @@index([rackId, status, createdAt])
  @@index([status, phase, createdAt])
  @@index([plannedDeliveryDate])
  @@index([shipTo])
}

model BatteryJobSlot {
  id                 String      @id @default(cuid())
  jobId              String
  job                BatteryJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  slotNumber         Int
  batteryId          String?
  beforeVoltage      Float?
  beforeVoltageMv    Int?
  beforeMeasuredAt   DateTime?
  afterVoltage       Float?
  afterVoltageMv     Int?
  afterMeasuredAt    DateTime?
  deliveryVoltage    Float?
  deliveryVoltageMv  Int?
  deliveryMeasuredAt DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([jobId, slotNumber])
  @@index([jobId, slotNumber])
}

model VoltMeterCalibration {
  id             String   @id @default(cuid())
  deviceId       String   @unique
  deviceName     String?
  inaGain        Float
  inaOffset      Float
  pointOneMeter  Float
  pointOneEsp    Float
  pointTwoMeter  Float
  pointTwoEsp    Float
  syncedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([deviceName])
  @@index([updatedAt])
}
